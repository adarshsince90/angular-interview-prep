{
  "name": "portal",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "generate-manifest": "node scripts/generate-manifest.mjs",
    "prebuild": "npm run generate-manifest",
    "start": "ng serve",
    "build": "ng build",
    "build:pages": "ng build --base-href /angular-interview-prep/",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "test:integrity": "node scripts/test-manifest-integrity.mjs"
  },
  "private": true,
  "packageManager": "npm@12.0.1",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "dompurify": "^3.4.15",
    "marked": "^18.0.13",
    "prismjs": "^1.30.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.7",
    "@angular/cli": "^22.0.7",
    "@angular/compiler-cli": "^22.0.0",
    "@types/dompurify": "^3.0.5",
    "@types/prismjs": "^1.26.6",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
